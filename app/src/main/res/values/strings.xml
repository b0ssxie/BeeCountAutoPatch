<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">蜜蜂记账自动记账补丁</string>
    <string name="xposed_description">为自动记账(AutoAccounting)注入蜜蜂记账(BeeCount)适配：经 beecount://add 深链写入账单。</string>
    <string name="version_format">模块版本 %1$s</string>

    <string name="category_title">蜜蜂记账分类名单（可选）</string>
    <string name="category_placeholder">每行一个分类名，例如：\n餐饮\n娱乐\n其他</string>
    <string name="category_hint">填这里之后，自动记账里那些在蜜蜂记账中不存在的分类会归到「其他」，原分类仍会写进备注。留空则不做兜底，按原分类照发。请先在蜜蜂记账里建好「其他」这个分类，并用 root 保存。</string>
    <string name="btn_save_categories">保存名单</string>
    <string name="btn_clear_categories">清空名单</string>
    <string name="category_status_loading">读取中…</string>
    <string name="category_status_ok">已读取 %1$d 个分类（%2$s）</string>
    <string name="category_status_none">未设置，不做兜底</string>
    <string name="category_saved">名单已保存</string>
    <string name="category_saved_empty">名单已清空，不再兜底</string>
    <string name="category_save_failed">保存失败（需要 root 授权）</string>
    <string name="log_location_hint">运行日志不再写文件：模块日志直接进 LSPosed 自带的日志页 —— 打开 LSPosed → 日志，搜 [BeeCountAutoPatch] 即可。本界面因此也不需要读写自动记账的私有目录。</string>
</resources>